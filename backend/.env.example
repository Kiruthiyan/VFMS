# Copy this file to backend/.env and fill in your local values.
# Never commit backend/.env to version control.

# ===============================
# DATABASE
# ===============================
# Supabase PostgreSQL only (Project Settings → Database → Connection string → JDBC)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===============================
# JWT
# ===============================
JWT_SECRET=replace-with-a-strong-32-char-plus-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===============================
# ADMIN SEED (first-run bootstrap)
# Password is encoded with BCrypt at startup — store plain text here only in local .env
# ===============================
ADMIN_SEED_ENABLED=true
ADMIN_SEED_CLEANUP_DEMO_USERS=false
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-local-only
ADMIN_SEED_FULL_NAME=System Administrator
ADMIN_SEED_PHONE=0000000000
ADMIN_SEED_NIC=000000000V

# Demo team accounts (set true only for local development)
TEAM_USERS_SEED_ENABLED=false

# ===============================
# FRONTEND / CORS
# ===============================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ===============================
# EMAIL (optional for local dev)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===============================
# SUPABASE STORAGE
# Required for driver license/document uploads AND fuel receipt uploads.
# Storage URL format: https://<your-project-ref>.supabase.co/storage/v1
# Service key: Supabase Dashboard → Project Settings → API → service_role key
# ===============================
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1
SUPABASE_STORAGE_BUCKET=fuel-receipts
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Driver module uses the same Supabase project but a separate bucket
DRIVER_SUPABASE_STORAGE_BUCKET=driver-documents
DRIVER_SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Staff profile pictures use private Supabase Storage
STAFF_SUPABASE_STORAGE_BUCKET=driver-documents
STAFF_SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Fleet maintenance/rental documents use private Supabase Storage
FLEET_SUPABASE_STORAGE_BUCKET=fleet-documents
FLEET_SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Report exports use private Supabase Storage
REPORT_SUPABASE_STORAGE_BUCKET=report-documents
REPORT_SUPABASE_SIGNED_URL_TTL_SECONDS=300
